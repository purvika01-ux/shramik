PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/contractor_register
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Forgot password emails. APP_URL = the website address used in the reset link.
# Leave SMTP_HOST empty in development: the reset link is then printed in this server's console.
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ShramikKhata <no-reply@example.com>"

# Used only by "npm run create-admin"
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@contractor.com
ADMIN_PASSWORD=admin123
